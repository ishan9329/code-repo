class Solution {
    public int[] findSum(int n) {

        int oddSum = 0;
        int evenSum = 0;

        for (int i = 1; i <= n; i++) {

            if (i % 2 != 0) {
                oddSum += i;
            } 
            else {
                evenSum += i;
            }
        }

        return new int[]{oddSum, evenSum};
    }
}
